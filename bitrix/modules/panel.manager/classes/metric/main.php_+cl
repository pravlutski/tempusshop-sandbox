    }

    public function getRecordsByModel($model) {
        $tables = [
            "lg_ozon_fbo",
            "lg_ozon_stock",
            "lg_ozon_price",
            "lg_price",
            "lg_pricelist"
        ];

        $results = [];

      foreach ($tables as $table) {
            $query = $this->connection->prepare("SELECT * FROM $table WHERE model REGEXP ?");
            $query->bind_param("s", $model);
            $query->execute();

            $result = $query->get_result();

            while ($row = $result->fetch_assoc()) {
                $results[] = $row;
            }

            $query->close();
        }

        usort($results, function($a, $b) {
            return strtotime($b['datetime']) - strtotime($a['datetime']);
        });

        return $results;
    }


    public function __destruct() {
        $this->connection->close();
    }
}
