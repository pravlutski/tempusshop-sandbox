    public function PriceListBase($data) {
        $stmt = $this->connection->prepare("INSERT INTO lg_pricelist_base (supplier_id, datetime) VALUES (?, ?)");
        $stmt->bind_param("ss", $data['supp_id'],  date('Y-m-d H:i:s'));

