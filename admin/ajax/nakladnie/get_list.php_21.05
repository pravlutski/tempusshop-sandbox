<script>
$(document).ready(function(){
	var spanValue = $('span.itogo').text();
	$('#top-ready').text(spanValue);
    $('[data-toggle="tooltip"]').tooltip();
		$(".close").on("click", function() {
			 if (confirm("Вы действительно хотите удалить?")) {
				 	 var type = $(this).attr("data-type");
					 var dataDelValue = $(this).attr("data-del");
					 $.ajax({
							 url: "/admin/ajax/nakladnie/delete_item.php",
							 method: "POST",
							 data: { delValue: dataDelValue, type:type},
							 success: function(response) {
								 if (confirm("Успешно удалено.")) {
										  var dataString = $('#date_to_report').val();
											$('#popup-stocks').addClass('active-pp');
											$.ajax({
												type: "POST",
												data: {date_to:dataString},
												url: "/admin/ajax/nakladnie/get_list.php",
												cache: false,
												crossDomain: true,
												xhrFields: {
													withCredentials: true
												},
												success: function(data) {
													$("#result-purchase").html(data);
													$('#popup-stocks').removeClass('active-pp');
												},
												error:function(data) {
													alert("Не удалось получить данные");
													$('#popup-stocks').removeClass('active-pp');
												}
											});
									}
							 },
							 error: function(xhr, status, error) {
									 console.error(status, error);
							 }
					 });
			 }
	 });
});
</script>
<style>
	.close {
	  width: 1em;
	  height: 1em;
	  background-color: red;
	  clip-path: polygon(20% 0%, 0% 20%, 30% 50%, 0% 80%, 20% 100%, 50% 70%, 80% 100%, 100% 80%, 70% 50%, 100% 20%, 80% 0%, 50% 30%);
		position: absolute;
  	right: 20px;
	}
</style>
