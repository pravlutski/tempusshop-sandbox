									if ($mnm['q'] != 0) {
										$objPHPExcel->getActiveSheet()->setCellValueByColumnAndRow($column, $row, $mnm['name']);
										$objPHPExcel->getActiveSheet()->setCellValueByColumnAndRow($column+1, $row, $gtd);
										$objPHPExcel->getActiveSheet()->setCellValueByColumnAndRow($column+2, $row, $mnm['q']);
										$row++;
									}
								}
							}
						}
				}
				$objWriter = PHPExcel_IOFactory::createWriter($objPHPExcel, 'Excel2007');
				$name = $dateN[0] .'-'.rand();
				$objWriter->save('/var/www/bitrix/data/www/tempusshop.ru/upload/nakladnie_cache/'.$name.'.xlsx');
