		}

	}

  public function getItems(){
		$this->db->Update("wdhs_ozon_upload_status", array("status" => "'INCOMPLETE'","percent" => "'0'"), "WHERE agent = 'sale'", $err_mess.__LINE__);


    $arSelect = Array("ID","IBLOCK_ID","IBLOCK_SECTION_ID","PROPERTY_OZON_ACTIVE","PROPERTY_CML2_ARTICLE","PROPERTY_OZSB_PRICE","PROPERTY_WBARTICLE","PROPERTY_TYPEOFSKLAD","PROPERTY_OZON_ID","PROPERTY_BRAND");
    $arFilter = Array(
      "IBLOCK_ID" => CProSet::IB_CATALOG,
      //"ID" => 180369,
			//"SECTION_ID" => 558
			"PROPERTY_OZON_ACTIVE_VALUE" => 'Да'
      //"ID" => 178901
    );
		//$arFilter["!ID"] = 14124;

    $result = CIBlockElement::GetList(array(), $arFilter, false, false, $arSelect);

    while ($el = $result->GetNext()){
			if (empty($el['PROPERTY_WBARTICLE_VALUE']) or $el['PROPERTY_WBARTICLE_VALUE'] == '') {
					$this->arLog['GET_ITEMS']['ERRORS']['NO_ARTICLE'][] = $el['ID'];
			}	else if (empty($el['PROPERTY_OZSB_PRICE_VALUE']) or $el['PROPERTY_OZSB_PRICE_VALUE'] == 0) {
					$this->arLog['GET_ITEMS']['ERRORS']['NO_PRICE'][] = $el['ID'];
			} else {
				$arSection = getSectionsElement($el["ID"]);
				// if ($arSection[1]['ID'] == '558') {
	    	$this->items[$el["PROPERTY_OZON_ID_VALUE"]] = [
	    		"ID" => $el["ID"],
					"MODEL" => $el["PROPERTY_CML2_ARTICLE_VALUE"],
	    		"OZON_ARTICLE" => $el["PROPERTY_WBARTICLE_VALUE"],
	    		"OZON_ID" => $el["PROPERTY_OZON_ID_VALUE"],
					"BRAND" => trim($el["PROPERTY_BRAND_VALUE"]),
	    	];
			}
    }

		$this->db->Update("wdhs_ozon_upload_status", array("percent" => '10'), "WHERE agent='sale'", $err_mess.__LINE__);

		file_put_contents("/var/www/bitrix/data/www/tempusshop.ru/admin/modules/OzonImport/logs/sales/tmp/arUpdateSale.txt", print_r($this->items, true));
	}

	public function getSebes(){
		foreach ($this->items as $key => &$v) {
			$tmpPrice = array();
			$strSql = "SELECT price, id, count, model, supplier_id FROM ci_price WHERE model = '".$v['MODEL']."' AND active_os = 'Y' ORDER BY price ASC" ;
			$results = $this->db->Query($strSql, false, $err_mess.__LINE__);
			while ($row = $results->Fetch()){
				$tmpPrice[$row['id']] = [
					'price' =>floatval($row['price']),
					'model' =>$row['model'],
					'count' => intval($row['count']),
					'supplier_id' => $row['supplier_id']
				];
			}

			$strSql = "SELECT * FROM ci_reserved WHERE ARTICLE = '".$v['ARTICLE']."'";
			$resultRes = $this->db->Query($strSql, false, $err_mess.__LINE__);
			$excludeReserved = [];
			while ( $row = $resultRes->Fetch() ){
				$excludeReserved[$row['ARTICLE']] = $row['RESERVED'];
			}

			$curReserved = null;
			$suppExcl = [];
			foreach($tmpPrice as $k => $value){
				if ( $curReserved != null ){
					if ( ($curReserved - $value['count'] >= 0) && !in_array($value['supplier_id'], $suppExcl) ){
						$curReserved = $curReserved - $value['count'];
						$suppExcl[] = $value['supplier_id'];
					}else{
						$minPrice = $value['price'];
						$price_id = $k;
						break;
					}
				}else{
					if ( isset($excludeReserved[$value['model']]) && ($excludeReserved[$value['model']] - $value['count'] >= 0) ){
						$curReserved = $excludeReserved[$value['model']] - $value['count'];
						$suppExcl[] = $value['supplier_id'];
					}else{
						$minPrice = $value['price'];
						$price_id = $k;
						break;
					}
				}
			}

			if ( !empty($tmpPrice) && !empty($minPrice) ) {
				$v['SEBES'] = $minPrice;
			} else {
				$v['SEBES'] ='';
			}
	}
	//print_r($this->items);
}

	public function GetActiveSales() {
		$strSql = "SELECT * FROM wdhs_ozon_sales";
		$results = $this->db->Query($strSql, false, $err_mess.__LINE__);

		while ($row = $results->Fetch()){
		  $this->salesActive[$row['sale_id']] = $row;
			$this->salesActiveNotSort[$row['sale_id']] = $row;
		}
		if (!empty($this->salesActive)) {
			foreach ($this->salesActive as $key => $sale) {
				if (!empty($sale['unset']) && $sale['unset'] != '') {
					if (strpos($sale['unset'], ',') !== false) {
						$this->salesActive[$key]['brand_unset'] = explode(',',trim($sale['unset']));
					} else {
						$this->salesActive[$key]['brand_unset'][] = trim($sale['unset']);
					}
				} else {
					$this->salesActive[$key]['brand_unset'] = array();
				}
				$this->arTmpRes[$sale['sale_id']]['GOOD'] = array();
				$this->arTmpRes[$sale['sale_id']]['BAD'] = array();
				$this->arTmpResU[$sale['sale_id']]['GOOD'] = array();
				$this->arTmpResU[$sale['sale_id']]['BAD'] = array();
			}
			usort($this->salesActive, function($a, $b) {
			    return $a['sort'] - $b['sort'];
			});
		}

		// print_r($this->salesActive);
		// die();
	}

	public function GetAllSalse()	{
		$this->NotActiveSales = array();
		$this->AllSale = array();
		$ch = curl_init($this->api_url . '/v1/actions');
		curl_setopt($ch, CURLOPT_HTTPHEADER, array(
		  'Api-Key:' . $this->token,
		  'Client-Id:' . $this->client_id,
		  'Content-Type:application/json'
		));
		curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
		curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
		curl_setopt($ch, CURLOPT_HEADER, false);
		$res = curl_exec($ch);
		curl_close($ch);

		$res = json_decode($res, true);
		foreach ($res['result'] as $k=>$r) {
			$this->AllSale[] = $r;
		}

		foreach ($this->AllSale as $key => $value) {
			if (!isset($this->salesActiveNotSort[$value['id']])) {
				$this->NotActiveSales[] = $value;
			}
		}
	}
  //текущие
	public function GetUsesProducts() {
		$this->NotActiveProduct = array();

		foreach ($this->salesActive as $key => $value) {
			$saleID = $value['sale_id'];
			$i = 0;
			$check = true;
			$this->tmpPorductsM[$saleID]['USES'] = array();
				while ($check == true) {
					$data_string = json_encode(array(
						"action_id"=> $saleID, "limit" => 1000,"offset" => $i
					));
					$ch = curl_init($this->api_url . '/v1/actions/products');
						curl_setopt($ch, CURLOPT_HTTPHEADER, array(
							'Api-Key:' . $this->token,
							'Client-Id:' . $this->client_id,
							'Content-Type:application/json'
						));
						curl_setopt($ch, CURLOPT_POSTFIELDS, $data_string);
						curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
						curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
						curl_setopt($ch, CURLOPT_HEADER, false);
						$res = curl_exec($ch);
						curl_close($ch);

						$res = json_decode($res, true);
						if (isset($res['result'])) {
							if (count($res['result']['products']) < 1000) {
								$check = false;
							} else {
								$check = true;
							}
						} else {
							$check = false;

							echo "ОШИБКА В ОТВЕТЕ API OZON";
							print_r('<br>');
							print_r($res);
							print_r('<br>');
							print_r('<<<<<');
							print_r('<br>');
							print_r($value['sale_id']);
						}
						foreach ($res['result']['products'] as $key => $value) {
							if (!isset($this->items[$value['id']])) {
								$this->NotActiveProduct[$saleID][] = [
									'product_id' => $value['id'],
									'need_price' => $value['max_action_price'],
								];
							} else {
								$this->tmpPorductsM[$saleID]['USES'][$value['id']] = [
									'product_id' => $value['id'],
									'need_price' => $value['max_action_price'],
								];
							}
						}
						$i=$i+1000;
					}

			}
	}

	public function GetPotencialProducts() {
		foreach ($this->salesActive as $key => $value) {
			$saleID = $value['sale_id'];
			$i = 0;
			$check = true;
			while ($check == true) {
				$data_string = json_encode(array(
					"action_id"=> $saleID, "limit" => 1000,"offset" => $i
				));
				$ch = curl_init($this->api_url . '/v1/actions/candidates');
					curl_setopt($ch, CURLOPT_HTTPHEADER, array(
						'Api-Key:' . $this->token,
						'Client-Id:' . $this->client_id,
						'Content-Type:application/json'
					));
					curl_setopt($ch, CURLOPT_POSTFIELDS, $data_string);
					curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
					curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
					curl_setopt($ch, CURLOPT_HEADER, false);
					$res = curl_exec($ch);
					curl_close($ch);

					$res = json_decode($res, true);
					if (isset($res['result'])) {
						if (count($res['result']['products']) < 1000) {
							$check = false;
						} else {
							$check = true;
						}
					} else {
						$check = false;
						print_r($res );
						echo "ОШИБКА В ОТВЕТЕ API OZON";
						die();
					}
					foreach ($res['result']['products'] as $key => $value) {
						if (isset($this->items[$value['id']])) {
							$this->tmpPorducts[$saleID]['CAN'][$value['id']] = [
								'product_id' => $value['id'],
								'need_price' => $value['max_action_price'],
							];
						}
					}
					$i=$i+1000;
				}
		}

	}

	public function CheckItemsUses() {

		$this->check = array();
		foreach ($this->items as $key => &$item) {
			if (!empty($this->salesActive)) {
				foreach ($this->salesActive as $k => $sale) {

					if(in_array($item['BRAND'],$sale['brand_unset'])) {

						$this->arTmpResU[$sale['sale_id']]['BAD'][$item['OZON_ID']] = [
							'ozon_id' => $item['OZON_ID'],
							'model' => $item['MODEL'],
							'sebes' => '',
							'needed' => '',
							'perc' => '',
							'skdSebes' => '',
							'com' => '',
							'newCom' => '',
							'merg' => '$merg',
							'min_profit' => '',
						];
						$reason = 'Бренд исключен!';
						//break;
					} else if (isset($this->tmpPorductsM[$sale['sale_id']]['USES'][$item['OZON_ID']]) && !empty($item['SEBES'])) {
						$needed = $this->tmpPorductsM[$sale['sale_id']]['USES'][$item['OZON_ID']]['need_price'];



						// if (isset($this->check[$item['OZON_ID']])) {
						// 	// print_r('<br>ISK: '.$item['OZON_ID'].' - '.$sale['sale_id'].' - ' .$item['MODEL'].'<br>');
						// 	// print_r(array());
						// 	$this->arTmpResU[$sale['sale_id']]['BAD'][$item['OZON_ID']] = [
						// 		'ozon_id' => $item['OZON_ID'],
						// 		'model' => $item['MODEL'],
						// 		'sebes' => $item['SEBES'],
						// 		'needed' => $needed,
						// 		'perc' => floatval($sale['perc']),
						// 		'skdSebes' => '',
						// 		'com' => '',
						// 		'newCom' => '',
						// 		'merg' => $merg,
						// 		'min_profit' => $this->minprof,
						// 	];
						// 	$this->arLog[$sale['sale_id']]['DELETE'][] = [
						// 		'ozon_id' => $item['OZON_ID'],
						// 		'model' => $item['MODEL'],
						// 		'reason' => 'Учавствует в акции с более высоким приорететом',
						// 	];
						// } else {
							if (!empty($sale['skd'])) {
							$newCom = (floatval($sale['com']) - $sale['skd']) / 100;
							$com = floatval($sale['com']) / 100;
							$merg = ($needed - $needed * $newCom) - $item['SEBES'];
							$fsb = $item['SEBES'] * floatval($sale['perc']);
							$skdSebesPerc = $fsb * ((($fsb - ($fsb * $newCom)) - ($fsb - ($fsb * $com)))/($fsb - ($fsb * $newCom)));
							$skdSebes = $fsb - $skdSebesPerc;
							if ($skdSebes > $needed or $this->minprof > $merg) {
								$this->arTmpResU[$sale['sale_id']]['BAD'][$item['OZON_ID']] = [
									'ozon_id' => $item['OZON_ID'],
									'model' => $item['MODEL'],
									'sebes' => $item['SEBES'],
									'needed' => $needed,
									'perc' => floatval($sale['perc']),
									'skdSebes' => $skdSebes,
									'com' => floatval($sale['com']),
									'newCom' => floatval($sale['com']) - $sale['skd'],
									'merg' => $merg,
									'min_profit' => $this->minprof,
								];
								if ($skdSebes > $needed) {
									$reason = 'Не проходим по мин. цене: '.$skdSebes .' > '.$needed.' (расчет с учетом уменьшенной коммиссии на '.$sale['skd'].')';
								} else if ($this->minprof > $merg) {
									$reason = 'Не проходим по минимально марженальности: '.$this->minprof  .' > '.$merg.' (расчет с учетом уменьшенной коммиссии на '.$sale['skd'].')';
								} else {
									$reason = "Ошибка неизвестна.";
								}
								$this->arLog[$sale['sale_id']]['DELETE'][] = [
									'ozon_id' => $item['OZON_ID'],
									'model' => $item['MODEL'],
									'reason' => $reason,
								];
							} else {
									$this->arTmpResU[$sale['sale_id']]['GOOD'][$item['OZON_ID']] = [
										'ozon_id' => $item['OZON_ID'],
										'model' => $item['MODEL'],
										'sebes' => $item['SEBES'],
										'needed' => $needed,
										'perc' => floatval($sale['perc']),
										'skdSebes' => $skdSebes,
										'com' => floatval($sale['com']),
										'newCom' => floatval($sale['com']) - $sale['skd'],
										'merg' => $merg,
										'min_profit' => $this->minprof,
									];
									if ($skdSebes < $needed && $this->minprof < $merg) {
										$reason = 'Проходим по всем сво-вам: '.$skdSebes .' < '.$needed.' и '.$this->minprof.' < '.$merg.' (расчет с учетом уменьшенной коммиссии на '.$sale['skd'].')';
									} else {
										$reason = "Неизвестный случай.";
									}
									$this->arLog[$sale['sale_id']]['STAY'][] = [
										'ozon_id' => $item['OZON_ID'],
										'model' => $item['MODEL'],
										'reason' => $reason,
									];
							 // unset($this->tmpPorductsM[$sale['sale_id']]['USES'][$item['OZON_ID']]);
							 // unset($this->items[$key]);
							 // print_r('<br>GOOD: '.$item['OZON_ID'].' - '.$sale['sale_id'].' - ' .$item['MODEL'].'<br>');
							 // print_r(array());
							 $this->check[$item['OZON_ID']] = 1;
							}
						} else {
								$com = floatval($sale['com']) / 100;
								$merg = ($needed - $needed * $com) - $item['SEBES'];
								if ($item['SEBES'] * floatval($sale['perc']) > $needed or $this->minprof > $merg) {
									$this->arTmpResU[$sale['sale_id']]['BAD'][$item['OZON_ID']] = [
										'ozon_id' => $item['OZON_ID'],
										'model' => $item['MODEL'],
										'sebes' => $item['SEBES'],
										'needed' => $needed,
										'perc' => $sale['perc'],
										'com' => $sale['com'],
										'merg' => $merg,
										'min_profit' => $this->minprof,
									];
									if ($item['SEBES'] * floatval($sale['perc']) > $needed) {
										$reason = 'Не проходим по мин. цене: '. $item['SEBES'] * floatval($sale['perc']) .' > '.$needed.'';
									} else if ($this->minprof > $merg) {
										$reason = 'Не проходим по минимально марженальности: '.$this->minprof  .' > '.$merg.'';
									} else {
										$reason = "Ошибка неизвестна.";
									}
									$this->arLog[$sale['sale_id']]['DELETE'][] = [
										'ozon_id' => $item['OZON_ID'],
										'model' => $item['MODEL'],
										'reason' => $reason,
									];
								} else {
										$this->arTmpResU[$sale['sale_id']]['GOOD'][$item['OZON_ID']] = [
											'ozon_id' => $item['OZON_ID'],
											'model' => $item['MODEL'],
											'sebes' => $item['SEBES'],
											'needed' => $needed,
											'perc' => $sale['perc'],
											'com' => $sale['com'],
											'merg' => $merg,
											'min_profit' => $this->minprof,
										];
										if ($item['SEBES'] * floatval($sale['perc']) < $needed && $this->minprof < $merg) {
											$sum = $item['SEBES'] * floatval($sale['perc']);
											$reason = 'Проходим по всем сво-вам: '.$sum.' < '.$needed.' и '.$this->minprof.' < '.$merg.'';
										} else {
											$reason = "Неизвестный случай.";
										}
										$this->arLog[$sale['sale_id']]['STAY'][] = [
											'ozon_id' => $item['OZON_ID'],
											'model' => $item['MODEL'],
											'reason' => $reason,
										];

									// unset($this->tmpPorductsM[$sale['sale_id']]['USES'][$item['OZON_ID']]);
									// unset($this->items[$key]);
									// print_r('<br>GOOD: '.$item['OZON_ID'].' - '.$sale['sale_id'].' - ' .$item['MODEL'].'<br>');
	 							 // print_r(array());
									$this->check[$item['OZON_ID']] = 1;
								}
							}
						//}
					}
				}
			}
		}
		file_put_contents("/var/www/bitrix/data/www/tempusshop.ru/admin/modules/OzonImport/logs/sales/log_2.txt", print_r(json_encode($this->arTmpResU), true));
	}

	public function UsesReplace(){
		if (!empty($this->salesActive)) {
			foreach ($this->salesActive as $k => $sale) {
				if (!empty($this->arTmpResU[$sale['sale_id']]['REP'])) {
					$tws = array_chunk($this->arTmpResU[$sale['sale_id']]['REP'],1000);
					// print_r('<br>********************************************************************************************************<br>');
					// print_r($sale['sale_id']);
					// print_r('<br>---------------------------------');
					foreach ($tws as $key => $values) {
							foreach ($values as $key => $v) {
								$tmpPrd[] = ['action_price' => $v['needed'], 'product_id'=> $v['ozon_id']];
							}
							$data_string = json_encode(array('action_id'=>$sale['sale_id'],'products'=>$tmpPrd));
							$ch = curl_init($this->api_url . '/v1/actions/products/activate');
								curl_setopt($ch, CURLOPT_HTTPHEADER, array(
									'Api-Key:' . $this->token,
									'Client-Id:' . $this->client_id,
									'Content-Type:application/json'
								));
								curl_setopt($ch, CURLOPT_POSTFIELDS, $data_string);
								curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
								curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
								curl_setopt($ch, CURLOPT_HEADER, false);
								$res = curl_exec($ch);
								curl_close($ch);

								$res = json_decode($res, true);
								//print_r($res);
								// foreach ($res['result'] as $k => $v) {
								// 		if ($v['updated'] == '1') {
								// 			$this->arLog['UPDATE']['GOOD'][] = $v['offer_id'];
								// 		} else {
								// 			$this->arLog['UPDATE']['BAD'][] = ['id' => $v['offer_id'],'errors' => $v['errors']];
								// 		}
								// }
								unset($tmpPrd);
					}
			}
			}
		}
	}

	public function DeactivateSales(){
			if (!empty($this->salesActive)) {
				foreach ($this->salesActive as $k => $sale) {
						if (empty($this->arTmpResU[$sale['sale_id']]['BAD'])) {
							continue;
						}

						$tws = array_chunk($this->arTmpResU[$sale['sale_id']]['BAD'],1000);
						foreach ($tws as $key => $values) {
							//print_r($values);
								foreach ($values as $key => $v) {
									$tmpPrd[] = $v['ozon_id'];
								}
								$data_string = json_encode(array('action_id'=>$sale['sale_id'],'product_ids'=>$tmpPrd));
								$ch = curl_init($this->api_url . '/v1/actions/products/deactivate');
									curl_setopt($ch, CURLOPT_HTTPHEADER, array(
										'Api-Key:' . $this->token,
										'Client-Id:' . $this->client_id,
										'Content-Type:application/json'
									));
									curl_setopt($ch, CURLOPT_POSTFIELDS, $data_string);
									curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
									curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
									curl_setopt($ch, CURLOPT_HEADER, false);
									$res = curl_exec($ch);
									curl_close($ch);

									$res = json_decode($res, true);

									unset($tmpPrd);
						}
				}
			}
	}
//потенциальные
	public function CheckItems() {

			foreach ($this->items as $key => &$item) {
				if (!empty($this->salesActive)) {
						foreach ($this->salesActive as $k => $sale) {

							if (in_array($item['BRAND'],$sale['brand_unset'])) {

							$this->arTmpRes[$sale['sale_id']]['BAD'][] = [
								'ozon_id' => $item['OZON_ID'],
								'model' => $item['MODEL'],
								'sebes' => '',
								'needed' => '',
								'perc' => '',
								'skdSebes' => '',
								'com' => '',
								'newCom' => '',
								'merg' => '$merg',
								'min_profit' => '',
							];
							$reason = 'Бренд исключен!';
							//break;
						} else	if (isset($this->tmpPorducts[$sale['sale_id']]['CAN'][$item['OZON_ID']]) && !empty($item['SEBES']) && !isset($this->arTmpResU[$sale['sale_id']]['GOOD'][$item['OZON_ID']])) {
							$needed = $this->tmpPorducts[$sale['sale_id']]['CAN'][$item['OZON_ID']]['need_price'];


							// if (isset($this->check[$item['OZON_ID']])) {
							// 	$this->arTmpRes[$sale['sale_id']]['BAD'][$item['OZON_ID']] = [
							// 		'ozon_id' => $item['OZON_ID'],
							// 		'model' => $item['MODEL'],
							// 		'sebes' => $item['SEBES'],
							// 		'needed' => $needed,
							// 		'perc' => floatval($sale['perc']),
							// 		'skdSebes' => '',
							// 		'com' => '',
							// 		'newCom' => '',
							// 		'merg' => $merg,
							// 		'min_profit' => $this->minprof,
							// 	];
							// 	$this->arLog[$sale['sale_id']]['NOT_ADD'][] = [
							// 		'ozon_id' => $item['OZON_ID'],
							// 		'model' => $item['MODEL'],
							// 		'reason' => 'Учавствует в акции с более высоким приорететом',
							// 	];
							//
							// 	break;
							// }
							if (!empty($sale['skd'])) {
								$newCom = (floatval($sale['com']) - $sale['skd']) / 100;
								// print_r('<br>');
								// print_r($newCom);
								$com = floatval($sale['com']) / 100;
								// print_r('<br>');
								// print_r($com);
								$merg = ($needed - $needed * $newCom) - $item['SEBES'];
								// print_r('<br>');
								// print_r($merg);
								$fsb = $item['SEBES'] * floatval($sale['perc']);
								// print_r('<br>');
								// print_r($fsb);
								$skdSebesPerc = $fsb * ((($fsb - ($fsb * $newCom)) - ($fsb - ($fsb * $com)))/($fsb - ($fsb * $newCom)));
								// print_r('<br>');
								// print_r($skdSebesPerc);
								$skdSebes = $fsb - $skdSebesPerc;
								// print_r('<br>');
								// print_r($skdSebes);
								//die();
								if ($skdSebes > $needed or $this->minprof > $merg) {
									$this->arTmpRes[$sale['sale_id']]['BAD'][] = [
										'ozon_id' => $item['OZON_ID'],
										'model' => $item['MODEL'],
										'sebes' => $item['SEBES'],
										'needed' => $needed,
										'perc' => floatval($sale['perc']),
										'skdSebes' => $skdSebes,
										'com' => floatval($sale['com']),
										'newCom' => floatval($sale['com']) - $sale['skd'],
										'merg' => $merg,
										'min_profit' => $this->minprof,
									];
									if ($skdSebes > $needed) {
										$reason = 'Не проходим по мин. цене: '.$skdSebes .' > '.$needed.' (расчет с учетом уменьшенной коммиссии на '.$sale['skd'].')';
									} else if ($this->minprof > $merg) {
										$reason = 'Не проходим по минимально марженальности: '.$this->minprof  .' > '.$merg.' (расчет с учетом уменьшенной коммиссии на '.$sale['skd'].')';
									} else {
										$reason = "Ошибка неизвестна.";
									}
									$this->arLog[$sale['sale_id']]['NOT_ADD'][] = [
										'ozon_id' => $item['OZON_ID'],
										'model' => $item['MODEL'],
										'reason' => $reason,
									];
								} else {
									$this->arTmpRes[$sale['sale_id']]['GOOD'][] = [
										'ozon_id' => $item['OZON_ID'],
										'model' => $item['MODEL'],
										'sebes' => $item['SEBES'],
										'needed' => $needed,
										'perc' => floatval($sale['perc']),
										'skdSebes' => $skdSebes,
										'com' => floatval($sale['com']),
										'newCom' => floatval($sale['com']) - $sale['skd'],
										'merg' => $merg,
										'min_profit' => $this->minprof,
									];
									if ($skdSebes < $needed && $this->minprof < $merg) {
										$reason = 'Проходим по всем сво-вам: '.$skdSebes .' < '.$needed.' и '.$this->minprof.' < '.$merg.' (расчет с учетом уменьшенной коммиссии на '.$sale['skd'].')';
									} else {
										$reason = "Неизвестный случай.";
									}
									$this->arLog[$sale['sale_id']]['ADD'][] = [
										'ozon_id' => $item['OZON_ID'],
										'model' => $item['MODEL'],
										'reason' => $reason,
									];
									// unset($this->tmpPorducts[$sale['sale_id']]['CAN'][$item['OZON_ID']]);
									// unset($this->items[$key]);
									$this->check[$item['OZON_ID']] = 1;
								}
							} else {
									$com = floatval($sale['com']) / 100;
									$merg = ($needed - $needed * $com) - $item['SEBES'];
									if ($item['SEBES'] * floatval($sale['perc']) > $needed or $this->minprof > $merg) {
										$this->arTmpRes[$sale['sale_id']]['BAD'][] = [
											'ozon_id' => $item['OZON_ID'],
											'model' => $item['MODEL'],
											'sebes' => $item['SEBES'],
											'needed' => $needed,
											'perc' => floatval($sale['perc']),
											'com' => floatval($sale['com']),
											'merg' => $merg,
											'min_profit' => $this->minprof,
										];
										if ($item['SEBES'] * floatval($sale['perc']) > $needed) {
											$reason = 'Не проходим по мин. цене: '. $item['SEBES'] * floatval($sale['perc']) .' > '.$needed.'';
										} else if ($this->minprof > $merg) {
											$reason = 'Не проходим по минимально марженальности: '.$this->minprof  .' > '.$merg.'';
										} else {
											$reason = "Ошибка неизвестна.";
										}
										$this->arLog[$sale['sale_id']]['NOT_ADD'][] = [
											'ozon_id' => $item['OZON_ID'],
											'model' => $item['MODEL'],
											'reason' => $reason,
										];
									} else {
										$this->arTmpRes[$sale['sale_id']]['GOOD'][] = [
											'ozon_id' => $item['OZON_ID'],
											'model' => $item['MODEL'],
											'sebes' => $item['SEBES'],
											'needed' => $needed,
											'perc' => floatval($sale['perc']),
											'com' => floatval($sale['com']),
											'merg' => $merg,
											'min_profit' => $this->minprof,
										];

										// unset($this->tmpPorducts[$sale['sale_id']]['CAN'][$item['OZON_ID']]);
										// unset($this->items[$key]);
										if ($item['SEBES'] * floatval($sale['perc']) < $needed && $this->minprof < $merg) {
											$reason = 'Проходим по всем сво-вам: '.$item['SEBES'] * floatval($sale['perc']).' < '.$needed.' и '.$this->minprof.' < '.$merg.'';
										} else {
											$reason = "Неизвестный случай.";
										}
										$this->arLog[$sale['sale_id']]['ADD'][] = [
											'ozon_id' => $item['OZON_ID'],
											'model' => $item['MODEL'],
											'reason' => $reason,
										];
										$this->check[$item['OZON_ID']] = 1;
									}
								}
						}
					}
				}
			}
	}

