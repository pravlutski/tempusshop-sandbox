		//   print_r('<span color="green">ДОБАВЛЯЕМ</span> - '.count($this->arTmpRes[$sale['sale_id']]['GOOD']).'<br>');
		// 	print_r('<span color="red">НЕ ДОБОВЛЯЕМ</span> - '.count($this->arTmpRes[$sale['sale_id']]['BAD']).'<br>');
		// }




